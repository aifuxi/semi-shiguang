{
  "name": "nuxt-ts-template",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nuxt build",
    "check": "npm run lint && npm run typecheck && npm run test:unit",
    "commitlint": "commitlint --edit",
    "dev": "nuxt dev",
    "format": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/ --concurrency auto",
    "generate": "nuxt generate",
    "lint": "eslint . --max-warnings=0 --cache --cache-location node_modules/.cache/eslint/ --concurrency auto",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "preview": "nuxt preview",
    "test": "npm run test:unit",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.11.3",
    "nuxt": "^4.4.8",
    "pinia": "^3.0.4",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@eslint/css": "^1.4.0",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^4.0.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.7.0",
    "eslint-plugin-better-tailwindcss": "^4.6.1",
    "eslint-plugin-check-file": "^3.3.1",
    "happy-dom": "^20.8.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "tailwind-csstree": "^0.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.5"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,jsx,tsx,vue,css,json,md,html,svg,png}": "eslint --fix --max-warnings=0 --no-warn-ignored"
  }
}
